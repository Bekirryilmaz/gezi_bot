# Bu dosyayi kopyalayip .env adiyla kaydet, gercek degerleri gir.
# .env dosyasi asla git'e eklenmez (bkz. kok dizindeki .gitignore).

# PostgreSQL baglanti adresi. Format: postgresql+psycopg://kullanici:sifre@host:port/veritabani_adi
VERITABANI_URL=postgresql+psycopg://gezi_kullanici:gezi_sifre@localhost:5432/gezi_veritabani

# 1 yaparsan calisan her SQL sorgusu konsola yazilir (hata ayiklama icin)
VERITABANI_SQL_LOGLA=0
